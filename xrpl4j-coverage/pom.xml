<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>xrpl4j-parent</artifactId>
    <groupId>org.xrpl</groupId>
    <version>HEAD-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>xrpl4j-coverage</artifactId>
  <name>xrpl4j :: coverage</name>
  <packaging>pom</packaging>
  <description>
    Aggregates JaCoCo coverage so that integration-test coverage is attributed to the modules under test. Ships no
    code. Without this, coverage from xrpl4j-integration-tests is discarded, because jacoco:report only analyses the
    classes of the module it runs in and that module has no main classes of its own.
  </description>

  <properties>
    <!-- Produces a report, not a library; must never be published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!--
      Scopes are load-bearing here (see the jacoco:report-aggregate documentation):
        compile - the project's classes AND execution data are included in the report.
        test    - ONLY the project's execution data is considered.
      So modules under test are compile-scoped, while xrpl4j-integration-tests is test-scoped: it contributes
      jacoco-it.exec without adding its own test classes to the report. That dependency also orders this module last
      in the reactor, so every exec file exists by the time the report runs.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>xrpl4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>xrpl4j-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>xrpl4j-integration-tests</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
